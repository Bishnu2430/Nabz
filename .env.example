# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL 17 + pgvector) -------------------------------------
POSTGRES_DB=nabz
POSTGRES_USER=nabz
POSTGRES_PASSWORD=change-me
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- API ---------------------------------------------------------------------
API_HOST_PORT=8000
APP_ENV=development
LOG_LEVEL=info

# --- Web app -----------------------------------------------------------------
WEB_HOST_PORT=5173
# The web app listens only on this computer. To open it from a phone on the same Wi-Fi (for example to scan a
# share link's QR code at a demo), set WEB_BIND=0.0.0.0 and APP_BASE_URL=http://<this computer's IP>:5173, then
# `docker compose up -d`. Use this on a network you trust, and set it back afterwards.
# WEB_BIND=127.0.0.1

# --- Accounts (docs/12-ux-and-access-design.md §3) ------------------------------
# Encrypts two-step sign-in secrets. Required outside development; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Where the links in emails point.
APP_BASE_URL=http://localhost:5173
# true when served over HTTPS (the session cookie is then marked Secure).
COOKIE_SECURE=false
# Every email goes to the Mailpit inbox at http://localhost:8025 (the `mailpit` service).
MAILPIT_HOST_PORT=8025
MAIL_FROM=Nabz <no-reply@nabz.local>

# --- Development account (local only) -------------------------------------------
# The development data from before Sprint 6 belongs to this account. Choose a password (kept only in your
# own .env) and set it with:
#   docker compose exec api python -m app.cli set-password --email dev@nabz.local --password <DEV_ACCOUNT_PASSWORD>
DEV_ACCOUNT_EMAIL=dev@nabz.local
DEV_ACCOUNT_PASSWORD=

# --- LLM providers (see docs/adr/0007-groq-gpt-oss-for-explanations.md) -------
# Explanations (Hindi / Odia / English) and the consent-gated vision fallback.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Local small model for row structuring (runs in the `ollama` service,
# enabled with: docker compose --profile local-llm up).
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen3:4b

# --- Text-to-speech (optional; docs/adr/0008-elevenlabs-for-narration.md) -----
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# eleven_multilingual_v2 has no Odia; Odia narration uses this model instead.
ELEVENLABS_MODEL_OR=eleven_v4
# Optional voice IDs; when empty, a warm or reassuring voice on the account is used.
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=
ELEVENLABS_VOICE_OR=
