# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL 17 + pgvector) -------------------------------------
POSTGRES_DB=nabz
POSTGRES_USER=nabz
POSTGRES_PASSWORD=change-me
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- API ---------------------------------------------------------------------
API_HOST_PORT=8000
APP_ENV=development
LOG_LEVEL=info

# --- LLM providers (see docs/adr/0004-hybrid-llm-strategy.md) ----------------
# Explanations (Hindi / Odia / English) and the consent-gated vision fallback.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# gpt-oss-120b is text-only; the consent-gated vision fallback needs a vision model.
# Check Groq's current model list before relying on this one.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local small model for row structuring (runs in the `ollama` service,
# enabled with: docker compose --profile local-llm up).
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen3:4b

# --- Text-to-speech (optional) -----------------------------------------------
TTS_PROVIDER=none
TTS_API_KEY=
