# Hosting with compose.prod.yaml (docs/14-setup-and-hosting.md).
# On the server: cp .env.production.example .env, fill it in, and never commit .env.

# --- Address -----------------------------------------------------------------------------------------------
# Your domain, pointed at this server with a DNS A record. Caddy gets the HTTPS certificate by itself.
# For a trial on your own computer: SITE_ADDRESS=:80, APP_BASE_URL=http://localhost (with the port, if you
# change HTTP_PORT) and COOKIE_SECURE=false.
SITE_ADDRESS=nabz.example.org
APP_BASE_URL=https://nabz.example.org
COOKIE_SECURE=true
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Secrets -----------------------------------------------------------------------------------------------
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY encrypts two-step sign-in secrets: keep it, or everyone must set up two-step sign-in again.
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=nabz
POSTGRES_USER=nabz

# --- Email (sign-up confirmation, password resets, reminders) ---------------------------------------------
# Any mail service's SMTP: usually port 587 with starttls, or 465 with ssl. Nobody can sign in until they have
# confirmed their email, so this must work before you invite people.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Nabz <no-reply@nabz.example.org>

# --- Explanations and narration (optional) ----------------------------------------------------------------
# Without GROQ_API_KEY, explanations use the safe template built from the values; without ELEVENLABS_API_KEY,
# there is no narration. Everything else works.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_MODEL_OR=eleven_v4

LOG_LEVEL=info
