# --- Secrets & local config -------------------------------------------------
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
.vite/

# --- Data that must never be committed --------------------------------------
# Real (even redacted) lab reports, uploads and model weights stay out of git.
data/private/
data/uploads/
# Generated synthetic reports (regenerate with `python -m tools.synthetic`); samples/ is committed.
data/synthetic/*
!data/synthetic/README.md
!data/synthetic/samples/
models/
*.gguf
*.safetensors

# --- College report template (contains institution logos; kept locally) ----
/Major_Project_Report_Sample*.docx
~$*.docx

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
